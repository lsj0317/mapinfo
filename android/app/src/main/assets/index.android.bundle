          cadastralOverlay = new kakao.maps.TileOverlay(['VWORLD_CAD'], 2, 0.75);
        } catch(te) { cadastralOverlay = null; }

        // 지도 이동 완료 이벤트
        kakao.maps.event.addListener(map, 'idle', function() {
          var c = map.getCenter();
          var b = map.getBounds();
