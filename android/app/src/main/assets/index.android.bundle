    function init() {
      try {
        var container = document.getElementById('map');
        var options = {
          center: new kakao.maps.LatLng(${initialRegion.latitude}, ${initialRegion.longitude}),
          level: ${initLevel}
        };
        map = new kakao.maps.Map(container, options);

